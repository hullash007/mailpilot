# Google OAuth (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Signs the cookie binding OAuth state to your browser (optional; random per process if empty)
OAUTH_STATE_SECRET=

# Access boundary: empty = loopback-only. Set for remote access (HTTPS required).
APP_ACCESS_TOKEN=
COOKIE_SECURE=0

# Token encryption (required before connecting Gmail): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# LLM endpoint (Phase 2, private VM/tunnel only)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# PostgreSQL (matches docker-compose.yml; both are required, choose a password)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg2://mailpilot:CHANGEME@localhost:5432/mailpilot
